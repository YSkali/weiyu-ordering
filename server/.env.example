# ============================================================
# 味遇点餐系统 - 环境变量配置
# 复制本文件为 .env 后填入实际值
# ============================================================

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=weiyu

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
# 用随机字符串，长度建议 >= 32
JWT_SECRET=change_this_to_a_random_string
JWT_EXPIRES_IN=2h

# ---------- 微信小程序 ----------
# 不需要小程序登录可以留空
WECHAT_APPID=
WECHAT_SECRET=

# ---------- 文件存储 ----------
# 目前用的是本地存储，不需要配 COS
# 如需腾讯云 COS，取消下面注释并填写
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=ap-guangzhou

# ---------- 服务端口 ----------
PORT=3000
